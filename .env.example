# ── RODE POULTRY — Environment Variables ──
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-very-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,www.rodepoultry.co.tz

# Database (Supabase PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DB_SSL=True

# Email (configure for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=jjbacketa@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=noreply@rodepoultry.co.tz

# Business
# Set COMPANY_DOMAIN once your domain is live (removes broken link from footer)
COMPANY_DOMAIN=

# Hero image: set to a Cloudinary/Uploadcare URL of an actual farm photo
# If empty, falls back to static/images/hero_farm.jpg (add your own photo)
HERO_IMAGE=
